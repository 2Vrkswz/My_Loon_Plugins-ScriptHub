#!name=滴滴企业版去广告
#!desc=移除滴滴企业版首页活动Banner及底部小福包按钮
#!author=ZaneWang
#!icon=https://github.com/2Vrkswz/Loon-Icons/blob/main/icons/didi_vstecs.png

[MITM]
# 添加我们需要解密的域名
hostname = eos-marketing.es.xiaojukeji.com, es-static.xiaojukeji.com

[Rewrite]
# 滴滴企业版 - 拦截“自费用车”气泡图片
^https:\/\/es-static\.xiaojukeji\.com\/static\/web\/node20250516\/83f369bbf3b72b8309412abab4e3cb92\/TbcRbkqMvI1747388538114\.png reject

[Script]
# 滴滴企业版 - 拦截顶部/中间横幅广告
http-response ^https:\/\/eos-marketing\.es\.xiaojukeji\.com\/api\/eos\/promotion\/batchList\/v1 requires-body=1, max-size=0, script-path=https://raw.githubusercontent.com/2Vrkswz/My_Loon_Plugins-ScriptHub/refs/heads/main/didi/didi_vstecs_removead.js, tag=滴滴去横幅广告

# 滴滴企业版 - 拦截底部导航栏“小福包”
http-response ^https:\/\/eos-marketing\.es\.xiaojukeji\.com\/api\/eos\/promotion\/list\/v4\?.*marks=es_app_fortunebag_tabbar requires-body=1, max-size=0, script-path=https://raw.githubusercontent.com/2Vrkswz/My_Loon_Plugins-ScriptHub/refs/heads/main/didi/didi_vstecs_removead.js, tag=滴滴去小福包
